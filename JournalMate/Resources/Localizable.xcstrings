          }
        }
      }
    },
    "The RevenueCat SDK is not integrated yet. Add the purchases-ios package in Xcode to enable billing." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RevenueCat SDK がまだ組み込まれていません。Xcode で purchases-ios パッケージを追加すると課金が有効になります。"
          }
        }
      }
    },
    "The team meeting ran long and I couldn't finish my own work." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
