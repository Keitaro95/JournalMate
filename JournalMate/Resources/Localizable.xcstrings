    "Support" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポート"
          }
        }
      }
    },
    "Talk about what's on your mind" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま考えていることを話す"
          }
        }
