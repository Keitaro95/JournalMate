    "AI asks one question at a time and draws out what's on your mind. No blank page to face." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIがひとつずつ問いかけて、考えていることを引き出します。白紙に向き合う必要はありません。"
          }
        }
      }
    },
    "AI journaling left this month" : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI での記録（今月の残り）"
          }
        }
      }
    },
    "AI replies aren't available right now. You can still save what you wrote as a journal." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまはAIの返答を使えません。書いた内容はそのままジャーナルとして保存できます。"
          }
        }
      }
    },
    "AI summarizes the conversation and suggests where it belongs. One tap saves it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話の要約も保存先も、AIが提案します。タップひとつで保存。"
          }
        }
      }
    },
    "AI usage today" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
