    "Title" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見出し"
          }
        }
      }
    },
    "To get replies from AI, allow what you write to be sent to AI. You can also continue without it and just write." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIから返事をもらうには、書いた内容をAIに送ることを許可してください。許可せずに、書くだけで進めることもできます。"
          }
        }
      }
    },
    "Today was about how the team runs meetings." : {
      "localizations" : {
        "ja" : {
